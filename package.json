{
	"name": "@kontent-ai/model-generator-monorepo",
	"private": true,
	"description": "Monorepo for Kontent.ai model generators (Delivery SDK, Migration toolkit, Sync SDK, environment & items models)",
	"repository": {
		"type": "git",
		"url": "https://github.com/kontent-ai/model-generator-js"
	},
	"author": "richard sustek",
	"license": "MIT",
	"engines": {
		"node": ">= 22"
	},
	"packageManager": "pnpm@11.15.0",
	"type": "module",
	"scripts": {
		"build": "turbo run build --log-order=grouped",
		"typecheck": "turbo run typecheck --log-order=grouped",
		"test": "turbo run test:unit test:integration --log-order=grouped",
		"test:unit": "turbo run test:unit --log-order=grouped",
		"test:integration": "turbo run test:integration --log-order=grouped",
		"lint": "turbo run lint --log-order=grouped",
		"biome:check": "turbo run biome:check --log-order=grouped",
		"biome:fix": "biome check --write",
		"biome:fix:unsafe": "biome check --write --unsafe",
		"ci:check": "turbo run typecheck build lint biome:check test:unit --log-order=grouped",
		"sample:all": "turbo run sample --concurrency=1 --log-order=grouped",
		"update:snapshots": "turbo run update:snapshots --concurrency=1 --log-order=grouped",
		"clean": "turbo run clean",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"changeset:publish": "changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@changesets/changelog-git": "1.0.0",
		"@changesets/cli": "3.0.3",
		"@kontent-ai/biome-config": "0.7.3",
		"@kontent-ai/eslint-config": "2.4.1",
		"@types/node": "26.6.2",
		"eslint": "10.11.0",
		"tsdown": "0.23.1",
		"tsx": "4.23.15",
		"turbo": "2.11.10",
		"typescript": "6.0.3",
		"vitest": "5.0.1"
	}
}
