{
	"name": "@kontent-ai/sync-sdk-model-generator",
	"version": "1.0.0-preview.0",
	"description": "Generates strongly typed models for the Kontent.ai Sync SDK (@kontent-ai/sync-sdk).",
	"repository": {
		"type": "git",
		"url": "https://github.com/kontent-ai/model-generator-js",
		"directory": "packages/sync-sdk-model-generator"
	},
	"author": "richard sustek",
	"license": "MIT",
	"engines": {
		"node": ">= 22"
	},
	"keywords": [
		"Kontent",
		"Kontent.ai",
		"Kontent.ai typings",
		"Kontent.ai models",
		"Kontent Model Generator",
		"Kontent.ai strongly typed models",
		"Kontent.ai Sync SDK"
	],
	"type": "module",
	"bin": {
		"kontent-generate-sync": "./dist/cli/app.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.json",
		"test:integration": "vitest run",
		"update:snapshots": "vitest run --update",
		"lint": "oxlint --type-aware --type-check",
		"biome:check": "biome check .",
		"clean": "rm -rf dist",
		"show:help": "tsx src/cli/app.ts --help",
		"sample": "tsx scripts/sample.ts",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"@biomejs/js-api": "catalog:",
		"@biomejs/wasm-nodejs": "catalog:",
		"@kontent-ai/core-sdk": "catalog:",
		"@kontent-ai/management-sdk": "catalog:",
		"coreSdkLegacy": "catalog:",
		"ts-pattern": "catalog:",
		"yargs": "catalog:"
	},
	"devDependencies": {
		"@kontent-ai/model-generator-shared": "workspace:*",
		"@kontent-ai/sync-sdk": "1.0.3"
	}
}
